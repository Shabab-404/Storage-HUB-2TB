    /* ==========================================================================
       INDEXEDDB LOCAL STORAGE ENGINE
       ========================================================================== */
    function initDatabase() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = (e) => {
          const dbInstance = e.target.result;
          if (!dbInstance.objectStoreNames.contains(STORE_NAME)) {
            dbInstance.createObjectStore(STORE_NAME, { keyPath: 'id' });
          }
        };
        req.onsuccess = (e) => {
          db = e.target.result;
          resolve(db);
        };
        req.onerror = () => reject(req.error);
      });
    }

    async function dbSaveItem(item) {
      if (!db) return;
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).put(item);
        tx.oncomplete = () => resolve();
      });
    }

    async function dbGetAll() {
      if (!db) return [];
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).getAll();
        req.onsuccess = () => resolve(req.result || []);
      });
    }

    async function dbDeleteItem(id) {
      if (!db) return;
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).delete(id);
        tx.oncomplete = () => resolve();
      });
    }

    async function dbClearAll() {
      if (!db) return;
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).clear();
        tx.oncomplete = () => resolve();
      });
    }

    /* ==========================================================================
       2.0 TB (2,048 GB) METRICS CALCULATOR
       ========================================================================== */
    function updateCapacityMetrics() {
      // Base hardware simulated archives:
      let rawMB = 368.4 * 1024;
      let videoMB = 246.0 * 1024;
      let backupMB = 69.8 * 1024;

      // Calculate dynamically with user's uploaded items
      mediaVault.forEach(item => {
        const sz = item.sizeMB || 25;
        if (item.category === 'video' || item.type === 'video') {
          videoMB += sz;
        } else if (item.category === 'backup') {
          backupMB += sz;
        } else {
          rawMB += sz;
        }
      });

      const rawGB = rawMB / 1024;
      const videoGB = videoMB / 1024;
      const backupGB = backupMB / 1024;
      const totalUsedGB = rawGB + videoGB + backupGB;
      const availGB = Math.max(0, TOTAL_CAPACITY_GB - totalUsedGB);
      const pctUsed = ((totalUsedGB / TOTAL_CAPACITY_GB) * 100).toFixed(1);

      // DOM Updates
      document.getElementById('usedGbLabel').textContent = totalUsedGB.toFixed(1);
      document.getElementById('availGbLabel').textContent = `${availGB.toFixed(1)} gb available`;
      document.getElementById('pctUsedLabel').textContent = `${pctUsed}% allocated`;

      // Visual segment bar widths
      document.getElementById('barRaw').style.width = `${((rawGB / TOTAL_CAPACITY_GB) * 100).toFixed(2)}%`;
      document.getElementById('barVideo').style.width = `${((videoGB / TOTAL_CAPACITY_GB) * 100).toFixed(2)}%`;
      document.getElementById('barBackup').style.width = `${((backupGB / TOTAL_CAPACITY_GB) * 100).toFixed(2)}%`;

      document.getElementById('catRawLabel').textContent = `${rawGB.toFixed(1)} gb`;
      document.getElementById('catVideoLabel').textContent = `${videoGB.toFixed(1)} gb`;
      document.getElementById('catBackupLabel').textContent = `${backupGB.toFixed(1)} gb`;

      // Update album badge counters
      document.getElementById('countAll').textContent = mediaVault.length;
      document.getElementById('countRoll').textContent = mediaVault.filter(m => m.album === 'camera-roll').length;
      document.getElementById('countVideo').textContent = mediaVault.filter(m => m.album === 'cinematic-video' || m.type === 'video').length;
      document.getElementById('countFav').textContent = mediaVault.filter(m => m.favorite).length;
      document.getElementById('countBackups').textContent = mediaVault.filter(m => m.album === 'phone-archives' || m.type === 'backup').length;
    }

    /* ==========================================================================
       GALLERY RENDERING & TAXONOMY FILTERS
       ========================================================================== */
    function renderGallery() {
      const feed = document.getElementById('mediaFeed');
      feed.innerHTML = '';

      filteredList = mediaVault.filter(item => {
        // Album constraint
        if (activeAlbum === 'camera-roll' && item.album !== 'camera-roll') return false;
        if (activeAlbum === 'cinematic-video' && (item.album !== 'cinematic-video' && item.type !== 'video')) return false;
        if (activeAlbum === 'favorites' && !item.favorite) return false;
        if (activeAlbum === 'phone-archives' && item.album !== 'phone-archives') return false;

        // Toolbar pill filter
        if (activeFilter === 'raw' && item.category !== 'raw') return false;
        if (activeFilter === 'video' && item.type !== 'video') return false;
        if (activeFilter === 'portrait' && item.category !== 'portrait') return false;
        if (activeFilter === 'favorites' && !item.favorite) return false;

        // Search text
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchTitle = (item.title || '').toLowerCase().includes(q);
          const matchCamera = (item.camera || '').toLowerCase().includes(q);
          const matchLoc = (item.location || '').toLowerCase().includes(q);
          if (!matchTitle && !matchCamera && !matchLoc) return false;
        }

        return true;
      });

      document.getElementById('itemsCountText').textContent = `showing ${filteredList.length} capture${filteredList.length === 1 ? '' : 's'}`;

      if (filteredList.length === 0) {
        feed.innerHTML = `
          <div style="grid-column: 1 / -1; padding: 4rem 1rem; text-align: center; color: var(--tan); font-style: italic;">
            <i data-lucide="archive" style="width: 32px; height: 32px; margin: 0 auto 0.8rem auto; opacity: 0.6;"></i>
            <p style="font-size: 0.95rem;">no archives match the current inquiry</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      if (currentViewMode === 'grid') {
        feed.className = 'editorial-grid';
        filteredList.forEach(item => {
          const card = document.createElement('div');
          card.className = 'media-card';
          card.onclick = () => openLightbox(item.id);

          const isChecked = selectedIds.has(item.id);

          card.innerHTML = `
            <div class="card-thumb-wrap">
              <img src="${item.thumb || item.url}" class="card-thumb" alt="${item.title}" loading="lazy">
              ${item.type === 'video' ? `
                <span class="video-pill">
                  <i data-lucide="play" style="width: 10px; height: 10px; fill: currentColor;"></i>
                  <span>${item.duration || '4k'}</span>
                </span>
              ` : ''}
              <div class="card-select-check ${isChecked ? 'checked' : ''}" onclick="event.stopPropagation(); toggleSelect('${item.id}')">
                <i data-lucide="check" style="width: 12px; height: 12px; display: ${isChecked ? 'block' : 'none'};"></i>
              </div>
            </div>
            <div class="card-caption">
              <div class="caption-title">${item.title}</div>
              <div class="caption-meta">
                <span>${item.camera}</span>
                <span>${item.sizeMB.toFixed(1)} mb</span>
              </div>
            </div>
          `;
          feed.appendChild(card);
        });
      } else {
        // List View
        feed.className = 'editorial-list';
        filteredList.forEach(item => {
          const row = document.createElement('div');
          row.className = 'list-row';
          row.onclick = () => openLightbox(item.id);

          const isChecked = selectedIds.has(item.id);

          row.innerHTML = `
            <div class="card-select-check ${isChecked ? 'checked' : ''}" onclick="event.stopPropagation(); toggleSelect('${item.id}')" style="position: static;">
              <i data-lucide="check" style="width: 12px; height: 12px; display: ${isChecked ? 'block' : 'none'};"></i>
            </div>
            <img src="${item.thumb || item.url}" class="list-thumb">
            <span style="color: var(--cream); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.title}</span>
            <span style="color: var(--tan); font-style: italic;">${item.camera}</span>
            <span style="color: var(--tan);">${item.date}</span>
            <span style="color: var(--cream); text-align: right;">${item.sizeMB.toFixed(1)} mb</span>
            <div style="text-align: right;">
              <i data-lucide="heart" style="width: 13px; height: 13px; color: ${item.favorite ? 'var(--crimson-accent)' : 'var(--tan)'}; fill: ${item.favorite ? 'var(--crimson-accent)' : 'none'};"></i>
            </div>
          `;
          feed.appendChild(row);
        });
      }

      lucide.createIcons();
    }

    /* ==========================================================================
       FILE UPLOAD & DRAG/DROP (WITH INDEXEDDB PERSISTENCE)
       ========================================================================== */
    async function handleIncomingFiles(fileList) {
      if (!fileList || !fileList.length) return;
      showToast(`archiving ${fileList.length} phone media item(s)...`);

      for (let i = 0; i < fileList.length; i++) {
        const file = fileList[i];
        const isVideo = file.type.startsWith('video/');
        const dataUrl = await readDataUrl(file);
        const szMB = file.size / (1024 * 1024);

        const newArchive = {
          id: 'user_media_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
          title: file.name,
          type: isVideo ? 'video' : 'photo',
          category: isVideo ? 'video' : 'raw',
          album: isVideo ? 'cinematic-video' : 'camera-roll',
          duration: isVideo ? '01:24' : null,
          url: dataUrl,
          thumb: dataUrl,
          sizeMB: szMB > 0 ? szMB : 32.5,
          camera: 'iPhone 16 Pro Max',
          lens: '24mm ƒ/1.78 Main',
          aperture: 'ƒ/1.78',
          shutter: '1/2400s',
          iso: 'ISO 64',
          resolution: isVideo ? '3840 × 2160 (4K 60fps)' : '8064 × 6048 (48 MP ProRAW)',
          location: 'Phone Local Storage',
          date: 'Oct 20, 2026',
          favorite: false
        };

        await dbSaveItem(newArchive);
        mediaVault.unshift(newArchive);
      }

      updateCapacityMetrics();
      renderGallery();
      showToast('media preserved successfully in 2.0 tb vault');
    }

    function readDataUrl(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => resolve(URL.createObjectURL(file));
        reader.readAsDataURL(file);
      });
    }

    /* ==========================================================================
       LIGHTBOX VIEWER & EXIF DRAWER
       ========================================================================== */
    function openLightbox(itemId) {
      const idx = filteredList.findIndex(m => m.id === itemId);
      if (idx === -1) return;
      currentLightboxIdx = idx;
      updateLightboxStage();
      document.getElementById('lightboxModal').classList.add('active');
    }

    function closeLightbox() {
      document.getElementById('lightboxModal').classList.remove('active');
      document.getElementById('stageMediaContainer').innerHTML = '';
    }

    function cycleModal(step) {
      if (filteredList.length === 0) return;
      currentLightboxIdx = (currentLightboxIdx + step + filteredList.length) % filteredList.length;
      updateLightboxStage();
    }

    function updateLightboxStage() {
      const item = filteredList[currentLightboxIdx];
      if (!item) return;

      const container = document.getElementById('stageMediaContainer');
      container.innerHTML = '';

      if (item.type === 'video') {
        const vid = document.createElement('video');
        vid.src = item.url;
        vid.controls = true;
        vid.autoplay = true;
        container.appendChild(vid);
      } else {
        const img = document.createElement('img');
        img.src = item.url;
        img.alt = item.title;
        container.appendChild(img);
      }

      document.getElementById('modalTitle').textContent = item.title;
      document.getElementById('modalSubInfo').textContent = `${item.resolution} • ${item.camera} • ${item.sizeMB.toFixed(1)} mb`;

      // EXIF metadata drawer
      document.getElementById('exifCamera').textContent = item.camera;
      document.getElementById('exifLens').textContent = item.lens;
      document.getElementById('exifAperture').textContent = item.aperture;
      document.getElementById('exifShutter').textContent = item.shutter;
      document.getElementById('exifIso').textContent = item.iso;
      document.getElementById('exifResolution').textContent = item.resolution;
      document.getElementById('exifSize').textContent = `${item.sizeMB.toFixed(1)} mb`;
      document.getElementById('exifAlbum').textContent = item.album;
      document.getElementById('exifLocation').textContent = item.location;
      document.getElementById('exifDate').textContent = item.date;

      const favBtn = document.getElementById('btnToggleFav');
      favBtn.onclick = () => {
        item.favorite = !item.favorite;
        dbSaveItem(item);
        updateCapacityMetrics();
        renderGallery();
        updateLightboxStage();
        showToast(item.favorite ? 'marked as favorite' : 'removed from favorites');
      };
      favBtn.querySelector('span').textContent = item.favorite ? 'favorited' : 'favorite';
      favBtn.querySelector('i').style.color = item.favorite ? 'var(--crimson-accent)' : 'var(--tan)';

      lucide.createIcons();
    }

    function downloadCurrentMedia() {
      const item = filteredList[currentLightboxIdx];
      if (!item) return;
      const a = document.createElement('a');
      a.href = item.url;
      a.download = item.title;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast(`saving ${item.title}`);
    }

    /* ==========================================================================
       TETHERED USB-C / CABLE PHONE SYNC SIMULATOR
       ========================================================================== */
    function openSyncModal() {
      document.getElementById('syncModal').classList.add('active');
    }

    function closeSyncModal() {
      document.getElementById('syncModal').classList.remove('active');
    }

    function startSyncSimulation() {
      const btn = document.getElementById('btnStartSync');
      btn.disabled = true;
      btn.style.opacity = '0.5';

      const fill = document.getElementById('syncProgressFill');
      const rateLabel = document.getElementById('syncRate');
      const pctLabel = document.getElementById('syncPercent');

      let progress = 0;
      const interval = setInterval(() => {
        progress += 4;
        fill.style.width = `${Math.min(progress, 100)}%`;
        pctLabel.textContent = `${Math.min(progress, 100)}%`;
        rateLabel.textContent = `${(1.18 + Math.random() * 0.15).toFixed(2)} gb/s throughput`;

        if (progress >= 100) {
          clearInterval(interval);
          setTimeout(async () => {
            // Ingest simulated synced phone asset
            const syncedBatch = {
              id: 'synced_usb_' + Date.now(),
              title: `IMG_DCIM_${Math.floor(1000 + Math.random() * 9000)}_ProRAW.dng`,
              type: 'photo',
              category: 'raw',
              album: 'camera-roll',
              url: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1600&q=85',
              thumb: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80',
              sizeMB: 52.4,
              camera: 'iPhone 16 Pro Max',
              lens: '24mm ƒ/1.78 Main',
              aperture: 'ƒ/1.78',
              shutter: '1/3200s',
              iso: 'ISO 50',
              resolution: '8064 × 6048 (48 MP ProRAW)',
              location: 'Yosemite National Park',
              date: 'Oct 20, 2026',
              favorite: true
            };

            await dbSaveItem(syncedBatch);
            mediaVault.unshift(syncedBatch);
            updateCapacityMetrics();
            renderGallery();

            closeSyncModal();
            btn.disabled = false;
            btn.style.opacity = '1';
            fill.style.width = '0%';
            showToast('tethered differential sync finished: +52.4 mb archived');
          }, 400);
        }
      }, 70);
    }

    /* ==========================================================================
       BATCH SELECTION & MANAGEMENT
       ========================================================================== */
    function toggleSelect(id) {
      if (selectedIds.has(id)) {
        selectedIds.delete(id);
      } else {
        selectedIds.add(id);
      }
      updateBatchBar();
      renderGallery();
    }

    function updateBatchBar() {
      const bar = document.getElementById('batchBar');
      const countLabel = document.getElementById('batchCountLabel');
      if (selectedIds.size > 0) {
        bar.classList.add('visible');
        countLabel.textContent = `${selectedIds.size} item${selectedIds.size === 1 ? '' : 's'} selected`;
      } else {
        bar.classList.remove('visible');
      }
    }

    async function batchDelete() {
      if (selectedIds.size === 0) return;
      for (const id of selectedIds) {
        await dbDeleteItem(id);
        mediaVault = mediaVault.filter(m => m.id !== id);
      }
      selectedIds.clear();
      updateBatchBar();
      updateCapacityMetrics();
      renderGallery();
      showToast('selected captures removed from vault');
    }

    function batchToggleFavorite() {
      selectedIds.forEach(id => {
        const item = mediaVault.find(m => m.id === id);
        if (item) {
          item.favorite = true;
          dbSaveItem(item);
        }
      });
      selectedIds.clear();
      updateBatchBar();
      updateCapacityMetrics();
      renderGallery();
      showToast('added selected to favorites');
    }

    function batchDownload() {
      selectedIds.forEach(id => {
        const item = mediaVault.find(m => m.id === id);
        if (item) {
          const a = document.createElement('a');
          a.href = item.url;
          a.download = item.title;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }
      });
      showToast(`downloading ${selectedIds.size} captures`);
      selectedIds.clear();
      updateBatchBar();
      renderGallery();
    }

    /* ==========================================================================
       TOAST NOTIFICATIONS
       ========================================================================== */
    function showToast(msg) {
      const tray = document.getElementById('toastTray');
      const toast = document.createElement('div');
      toast.className = 'toast-msg';
      toast.innerHTML = `
        <i data-lucide="info" style="width: 14px; height: 14px; color: var(--tan);"></i>
        <span>${msg}</span>
      `;
      tray.appendChild(toast);
      lucide.createIcons();

      requestAnimationFrame(() => toast.classList.add('show'));

      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 400);
      }, 3500);
    }

    async function resetVaultDemo() {
      await dbClearAll();
      mediaVault = [...SEED_DATA];
      for (const item of mediaVault) {
        await dbSaveItem(item);
      }
      selectedIds.clear();
      updateBatchBar();
      updateCapacityMetrics();
      renderGallery();
      showToast('restored factory default 2.0 tb archives');
    }

    /* ==========================================================================
       SETUP EVENT LISTENERS
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', async () => {
      await initDatabase();
      const existing = await dbGetAll();

      if (existing && existing.length > 0) {
        mediaVault = existing;
      } else {
        mediaVault = [...SEED_DATA];
        for (const s of mediaVault) {
          await dbSaveItem(s);
        }
      }

      updateCapacityMetrics();
      renderGallery();

      // Search Handler
      const sInput = document.getElementById('searchInput');
      sInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderGallery();
      });

      // Filter Pills
      document.querySelectorAll('.pill-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeFilter = btn.getAttribute('data-filter');
          renderGallery();
        });
      });

      // Album Sidebar Nav
      document.querySelectorAll('.album-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.album-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeAlbum = btn.getAttribute('data-album');
          renderGallery();
        });
      });

      // View Mode Toggle
      document.getElementById('btnViewGrid').addEventListener('click', () => {
        currentViewMode = 'grid';
        document.getElementById('btnViewGrid').classList.add('active');
        document.getElementById('btnViewList').classList.remove('active');
        renderGallery();
      });

      document.getElementById('btnViewList').addEventListener('click', () => {
        currentViewMode = 'list';
        document.getElementById('btnViewList').classList.add('active');
        document.getElementById('btnViewGrid').classList.remove('active');
        renderGallery();
      });

      // Drag and Drop
      const dropBox = document.getElementById('dropArea');
      const fileInput = document.getElementById('directFileInput');

      ['dragenter', 'dragover'].forEach(name => {
        dropBox.addEventListener(name, (e) => {
          e.preventDefault();
          dropBox.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropBox.addEventListener(name, (e) => {
          e.preventDefault();
          dropBox.classList.remove('dragover');
        });
      });

      dropBox.addEventListener('drop', (e) => {
        if (e.dataTransfer && e.dataTransfer.files) {
          handleIncomingFiles(e.dataTransfer.files);
        }
      });

      dropBox.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => {
        handleIncomingFiles(e.target.files);
        fileInput.value = '';
      });

      // Keyboard navigation
      window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('lightboxModal');
        if (!modal.classList.contains('active')) return;

        if (e.key === 'ArrowLeft') cycleModal(-1);
        if (e.key === 'ArrowRight') cycleModal(1);
        if (e.key === 'Escape') closeLightbox();
      });
    });
  </script>
</body>
</html>
