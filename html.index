<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>atelier vault • 2.0 tb private phone media hub</title>
  
  <!-- Embedded Lucide Icons Script -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* ==========================================================================
       LUXURY PALETTE DESIGN SYSTEM & BESPOKE TIMES NEW ROMAN TYPOGRAPHY
       Palette:
         - Deep Merlot: #4A0404
         - Lighter Red / Crimson: #9D2525
         - Cream: #F5EBE0
         - Tan: #DBC1AC
         - Light Brown: #A37C5B
         - Obsidian / Deep Base: #1f0202
       ========================================================================== */
    :root {
      --merlot-deep: #4A0404;
      --merlot-dark: #2f0202;
      --merlot-base: #1b0202;
      --merlot-surface: #380303;
      --crimson-accent: #9D2525;
      --crimson-hover: #b82d2d;
      --cream: #F5EBE0;
      --cream-dim: rgba(245, 235, 224, 0.72);
      --cream-faint: rgba(245, 235, 224, 0.12);
      --tan: #DBC1AC;
      --tan-border: rgba(219, 193, 172, 0.28);
      --tan-subtle: rgba(219, 193, 172, 0.12);
      --light-brown: #A37C5B;
      --font-editorial: 'Times New Roman', Times, Georgia, serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: radial-gradient(circle at 10% 10%, #300303 0%, #170101 60%, #0d0101 100%);
      color: var(--cream);
      font-family: var(--font-editorial);
      font-size: 15px;
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    /* Custom Luxury Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: var(--merlot-base);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--light-brown);
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--tan);
    }

    /* Subtle fine-line border utility */
    .hairline-border {
      border: 1px solid var(--tan-border);
    }

    /* Header styling */
    header {
      background: rgba(47, 2, 2, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--tan-border);
      position: sticky;
      top: 0;
      z-index: 40;
      padding: 0.9rem 1.8rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .brand-crest {
      width: 38px;
      height: 38px;
      border: 1px solid var(--tan);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--merlot-deep), var(--crimson-accent));
      color: var(--cream);
      box-shadow: 0 4px 15px rgba(157, 37, 37, 0.35);
      flex-shrink: 0;
    }

    .brand-titles h1 {
      font-size: 1.15rem;
      font-weight: 400;
      letter-spacing: 0.15em;
      text-transform: lowercase;
      color: var(--cream);
      line-height: 1.1;
    }

    .brand-titles p {
      font-size: 0.72rem;
      color: var(--tan);
      letter-spacing: 0.2em;
      text-transform: lowercase;
      font-style: italic;
    }

    .search-bar-wrap {
      flex: 1;
      max-width: 440px;
      position: relative;
    }

    .search-input {
      width: 100%;
      background: rgba(31, 2, 2, 0.85);
      border: 1px solid var(--tan-border);
      color: var(--cream);
      font-family: var(--font-editorial);
      font-size: 0.88rem;
      font-style: italic;
      padding: 0.55rem 2.4rem 0.55rem 1rem;
      border-radius: 4px;
      transition: all 0.25s ease;
    }
    .search-input:focus {
      outline: none;
      border-color: var(--tan);
      background: rgba(45, 3, 3, 0.95);
      box-shadow: 0 0 16px rgba(219, 193, 172, 0.15);
    }
    .search-icon {
      position: absolute;
      right: 0.8rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--tan);
      pointer-events: none;
      width: 16px;
      height: 16px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    /* Elegant Buttons */
    .btn-luxury {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-editorial);
      font-size: 0.82rem;
      letter-spacing: 0.14em;
      text-transform: lowercase;
      color: var(--cream);
      background: linear-gradient(135deg, var(--crimson-accent), var(--merlot-deep));
      border: 1px solid var(--tan);
      padding: 0.55rem 1.1rem;
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 3px 12px rgba(74, 4, 4, 0.4);
      text-decoration: none;
    }
    .btn-luxury:hover {
      background: linear-gradient(135deg, var(--crimson-hover), #610707);
      transform: translateY(-1px);
      box-shadow: 0 5px 18px rgba(157, 37, 37, 0.45);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-editorial);
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--tan);
      background: rgba(31, 2, 2, 0.5);
      border: 1px solid var(--tan-border);
      padding: 0.5rem 0.95rem;
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-outline:hover {
      border-color: var(--tan);
      color: var(--cream);
      background: var(--merlot-surface);
    }

    /* Layout structure */
    .app-body {
      display: flex;
      flex: 1;
      overflow: hidden;
      position: relative;
    }

    /* Left Sidebar: 2.0 TB Metrics, Device status & Albums */
    .sidebar {
      width: 340px;
      background: rgba(37, 3, 3, 0.92);
      border-right: 1px solid var(--tan-border);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow-y: auto;
      padding: 1.6rem 1.4rem;
      gap: 1.8rem;
    }

    /* 2.0 TB Metric Showcase */
    .storage-card {
      background: linear-gradient(180deg, #3d0505 0%, #260202 100%);
      border: 1px solid var(--tan-border);
      border-radius: 6px;
      padding: 1.3rem;
      box-shadow: 0 8px 24px rgba(27, 2, 2, 0.6);
      position: relative;
    }

    .storage-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5rem;
    }

    .storage-tag {
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: lowercase;
      color: var(--tan);
      font-style: italic;
    }

    .storage-quota-badge {
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      color: var(--cream);
      background: var(--merlot-deep);
      border: 1px solid var(--tan-border);
      padding: 0.15rem 0.5rem;
      border-radius: 2px;
    }

    .storage-large-num {
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
      margin: 0.4rem 0 0.8rem 0;
    }

    .storage-large-num .amount {
      font-size: 2.2rem;
      font-weight: 400;
      color: var(--cream);
      letter-spacing: 0.05em;
    }

    .storage-large-num .total {
      font-size: 0.9rem;
      color: var(--tan);
      font-style: italic;
      letter-spacing: 0.08em;
    }

    /* Multi-Segment Capacity Bar */
    .capacity-track {
      height: 9px;
      background: #140101;
      border: 1px solid var(--tan-border);
      border-radius: 2px;
      display: flex;
      overflow: hidden;
      margin: 0.6rem 0;
      gap: 1px;
    }

    .segment-bar {
      height: 100%;
      transition: width 0.4s ease;
    }
    .seg-raw { background: #DBC1AC; } /* Tan: RAW */
    .seg-video { background: #9D2525; } /* Crimson: 4K */
    .seg-backup { background: #A37C5B; } /* Light Brown: Backups */

    .capacity-legend {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--tan);
      letter-spacing: 0.08em;
      margin-top: 0.4rem;
      font-style: italic;
    }

    .category-breakdown {
      margin-top: 1.1rem;
      border-top: 1px solid var(--tan-subtle);
      padding-top: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .category-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
    }

    .category-name {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--cream-dim);
      letter-spacing: 0.05em;
    }

    .cat-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
    }

    .category-val {
      color: var(--cream);
      letter-spacing: 0.08em;
      font-size: 0.78rem;
    }

    /* Phone Status Card */
    .phone-sync-card {
      background: rgba(31, 2, 2, 0.7);
      border: 1px solid var(--tan-border);
      border-radius: 5px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .phone-sync-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .phone-meta {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .phone-icon-box {
      width: 32px;
      height: 32px;
      border-radius: 4px;
      background: var(--merlot-deep);
      border: 1px solid var(--tan-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--tan);
    }

    .phone-texts h4 {
      font-size: 0.86rem;
      font-weight: 400;
      color: var(--cream);
      letter-spacing: 0.08em;
      text-transform: lowercase;
    }

    .phone-texts p {
      font-size: 0.7rem;
      color: var(--tan);
      letter-spacing: 0.1em;
      font-style: italic;
    }

    .status-pulse {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.7rem;
      color: #9D2525;
      letter-spacing: 0.1em;
      font-style: italic;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      background: var(--crimson-accent);
      border-radius: 50%;
      box-shadow: 0 0 8px #9D2525;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Album Navigation */
    .nav-group-title {
      font-size: 0.72rem;
      color: var(--tan);
      letter-spacing: 0.22em;
      text-transform: lowercase;
      font-style: italic;
      margin-bottom: 0.6rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .album-nav {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .album-btn {
      width: 100%;
      background: transparent;
      border: none;
      border-radius: 3px;
      color: var(--cream-dim);
      font-family: var(--font-editorial);
      font-size: 0.88rem;
      letter-spacing: 0.09em;
      text-transform: lowercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 0.7rem;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: left;
    }

    .album-btn:hover {
      background: var(--merlot-surface);
      color: var(--cream);
    }

    .album-btn.active {
      background: linear-gradient(90deg, rgba(157, 37, 37, 0.4) 0%, rgba(74, 4, 4, 0.2) 100%);
      color: var(--cream);
      border-left: 2px solid var(--tan);
    }

    .album-badge {
      font-size: 0.72rem;
      color: var(--tan);
      letter-spacing: 0.05em;
      font-style: italic;
    }

    /* Main Content Area */
    .main-gallery {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      background: rgba(22, 1, 1, 0.95);
    }

    /* Drag & Drop Hero Atelier Box */
    .drop-banner {
      padding: 1.5rem 2rem 0.5rem 2rem;
    }

    .dropzone-box {
      border: 1px dashed var(--tan-border);
      border-radius: 5px;
      background: linear-gradient(135deg, rgba(74, 4, 4, 0.3) 0%, rgba(31, 2, 2, 0.5) 100%);
      padding: 1.8rem 1.5rem;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.3s ease;
    }
    .dropzone-box:hover, .dropzone-box.dragover {
      border-color: var(--tan);
      background: linear-gradient(135deg, rgba(157, 37, 37, 0.25) 0%, rgba(74, 4, 4, 0.45) 100%);
      box-shadow: 0 0 25px rgba(219, 193, 172, 0.12);
    }

    .dropzone-icon {
      width: 44px;
      height: 44px;
      margin: 0 auto 0.7rem auto;
      border: 1px solid var(--tan-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--tan);
      background: rgba(31, 2, 2, 0.6);
    }

    .dropzone-title {
      font-size: 1.05rem;
      font-weight: 400;
      color: var(--cream);
      letter-spacing: 0.12em;
      text-transform: lowercase;
    }

    .dropzone-sub {
      font-size: 0.78rem;
      color: var(--tan);
      letter-spacing: 0.1em;
      font-style: italic;
      margin-top: 0.25rem;
    }

    /* Gallery Controls Header */
    .gallery-toolbar {
      padding: 1.2rem 2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--tan-border);
      background: rgba(27, 2, 2, 0.9);
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(8px);
    }

    .filter-pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .pill-btn {
      font-family: var(--font-editorial);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--tan);
      background: rgba(47, 2, 2, 0.7);
      border: 1px solid var(--tan-border);
      padding: 0.35rem 0.85rem;
      border-radius: 2px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .pill-btn:hover {
      color: var(--cream);
      border-color: var(--tan);
    }
    .pill-btn.active {
      background: var(--merlot-deep);
      color: var(--cream);
      border-color: var(--tan);
      box-shadow: 0 2px 8px rgba(74, 4, 4, 0.4);
    }

    .toolbar-tools {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .selection-banner {
      font-size: 0.78rem;
      color: var(--tan);
      font-style: italic;
      letter-spacing: 0.08em;
    }

    .view-mode-toggle {
      display: flex;
      border: 1px solid var(--tan-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .view-mode-btn {
      background: rgba(31, 2, 2, 0.8);
      border: none;
      color: var(--tan);
      padding: 0.35rem 0.65rem;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      display: flex;
      align-items: center;
    }
    .view-mode-btn.active {
      background: var(--crimson-accent);
      color: var(--cream);
    }

    /* Media Containers */
    .gallery-container {
      padding: 1.8rem 2rem 4rem 2rem;
      flex: 1;
    }

    /* Masonry / Editorial Grid */
    .editorial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.4rem;
    }

    .media-card {
      background: rgba(39, 3, 3, 0.8);
      border: 1px solid var(--tan-border);
      border-radius: 4px;
      overflow: hidden;
      position: relative;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
      display: flex;
      flex-direction: column;
    }
    .media-card:hover {
      transform: translateY(-3px);
      border-color: var(--tan);
      box-shadow: 0 12px 28px rgba(10, 0, 0, 0.6);
    }

    .card-thumb-wrap {
      aspect-ratio: 4/3;
      width: 100%;
      background: #120101;
      position: relative;
      overflow: hidden;
    }

    .card-thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .media-card:hover .card-thumb {
      transform: scale(1.04);
    }

    .video-pill {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      background: rgba(20, 1, 1, 0.82);
      border: 1px solid var(--tan-border);
      color: var(--cream);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      padding: 0.15rem 0.45rem;
      border-radius: 2px;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      backdrop-filter: blur(4px);
    }

    .card-select-check {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      width: 20px;
      height: 20px;
      border-radius: 3px;
      border: 1px solid var(--tan-border);
      background: rgba(31, 2, 2, 0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      z-index: 5;
    }
    .card-select-check.checked {
      background: var(--crimson-accent);
      border-color: var(--tan);
      color: var(--cream);
    }

    .card-caption {
      padding: 0.85rem 0.95rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      border-top: 1px solid var(--tan-subtle);
      background: rgba(27, 2, 2, 0.92);
    }

    .caption-title {
      font-size: 0.88rem;
      font-weight: 400;
      color: var(--cream);
      letter-spacing: 0.08em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-transform: lowercase;
    }

    .caption-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      color: var(--tan);
      font-style: italic;
      letter-spacing: 0.06em;
    }

    /* Archive List View */
    .editorial-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .list-row {
      display: grid;
      grid-template-columns: 32px 64px 2fr 1.2fr 1fr 1fr 40px;
      align-items: center;
      padding: 0.6rem 1rem;
      background: rgba(35, 3, 3, 0.7);
      border: 1px solid var(--tan-border);
      border-radius: 3px;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
      font-size: 0.82rem;
    }
    .list-row:hover {
      background: var(--merlot-surface);
      border-color: var(--tan);
    }

    .list-thumb {
      width: 48px;
      height: 38px;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid var(--tan-border);
    }

    /* Fullscreen Lightbox & Luxury EXIF Drawer */
    .lightbox-modal {
      position: fixed;
      inset: 0;
      background: rgba(14, 1, 1, 0.96);
      backdrop-filter: blur(16px);
      z-index: 100;
      display: none;
      flex-direction: column;
    }
    .lightbox-modal.active {
      display: flex;
    }

    .lightbox-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.8rem;
      border-bottom: 1px solid var(--tan-border);
      background: rgba(27, 2, 2, 0.95);
    }

    .lightbox-titles h3 {
      font-size: 1.05rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--cream);
    }

    .lightbox-titles p {
      font-size: 0.74rem;
      color: var(--tan);
      letter-spacing: 0.1em;
      font-style: italic;
    }

    .lightbox-actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .lightbox-stage {
      flex: 1;
      display: flex;
      overflow: hidden;
      position: relative;
    }

    .stage-media-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
    }

    .stage-media-wrap img, .stage-media-wrap video {
      max-width: 90%;
      max-height: 82vh;
      border: 1px solid var(--tan-border);
      border-radius: 4px;
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.8);
      object-fit: contain;
    }

    .stage-nav-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--tan-border);
      background: rgba(36, 2, 2, 0.75);
      color: var(--tan);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      z-index: 10;
    }
    .stage-nav-btn:hover {
      background: var(--crimson-accent);
      color: var(--cream);
      border-color: var(--tan);
    }
    .nav-prev { left: 1.5rem; }
    .nav-next { right: 1.5rem; }

    /* Metadata Atelier Drawer */
    .metadata-drawer {
      width: 340px;
      background: rgba(30, 2, 2, 0.95);
      border-left: 1px solid var(--tan-border);
      overflow-y: auto;
      padding: 1.6rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .drawer-section-title {
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: lowercase;
      color: var(--tan);
      font-style: italic;
      border-bottom: 1px solid var(--tan-subtle);
      padding-bottom: 0.4rem;
      margin-bottom: 0.8rem;
    }

    .exif-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .exif-box {
      background: rgba(43, 3, 3, 0.6);
      border: 1px solid var(--tan-border);
      border-radius: 3px;
      padding: 0.6rem 0.7rem;
    }

    .exif-label {
      font-size: 0.68rem;
      color: var(--tan);
      letter-spacing: 0.12em;
      font-style: italic;
      display: block;
      margin-bottom: 0.2rem;
    }

    .exif-value {
      font-size: 0.82rem;
      color: var(--cream);
      letter-spacing: 0.05em;
    }

    /* Luxury Tethered Phone Sync Modal */
    .sync-modal {
      position: fixed;
      inset: 0;
      background: rgba(14, 1, 1, 0.85);
      backdrop-filter: blur(12px);
      z-index: 120;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .sync-modal.active {
      display: flex;
    }

    .sync-dialog {
      width: 100%;
      max-width: 460px;
      background: linear-gradient(180deg, #3d0505 0%, #200202 100%);
      border: 1px solid var(--tan);
      border-radius: 6px;
      padding: 2rem;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.9);
      text-align: center;
      position: relative;
    }

    .sync-crest {
      width: 56px;
      height: 56px;
      margin: 0 auto 1.2rem auto;
      border: 1px solid var(--tan);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--merlot-deep);
      color: var(--tan);
    }

    .sync-dialog h3 {
      font-size: 1.3rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--cream);
      margin-bottom: 0.4rem;
    }

    .sync-dialog p {
      font-size: 0.8rem;
      color: var(--tan);
      letter-spacing: 0.08em;
      font-style: italic;
      margin-bottom: 1.4rem;
    }

    .sync-progress-track {
      height: 8px;
      background: #120101;
      border: 1px solid var(--tan-border);
      border-radius: 2px;
      overflow: hidden;
      margin: 1rem 0;
    }

    .sync-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--light-brown), var(--tan));
      width: 0%;
      transition: width 0.15s ease;
    }

    .sync-stats-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--tan);
      font-style: italic;
      letter-spacing: 0.08em;
    }

    /* Batch action floating toolbar */
    .batch-bar {
      position: fixed;
      bottom: 1.8rem;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: rgba(36, 2, 2, 0.95);
      border: 1px solid var(--tan);
      border-radius: 4px;
      padding: 0.6rem 1.4rem;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.7);
      z-index: 30;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .batch-bar.visible {
      transform: translateX(-50%) translateY(0);
    }

    /* Notifications Toast */
    .toast-tray {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 150;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      pointer-events: none;
    }

    .toast-msg {
      background: rgba(35, 2, 2, 0.94);
      border: 1px solid var(--tan);
      color: var(--cream);
      padding: 0.75rem 1.2rem;
      border-radius: 3px;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
      transform: translateY(20px);
      opacity: 0;
      transition: all 0.3s ease;
    }
    .toast-msg.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* Responsive Queries */
    @media (max-width: 900px) {
      .sidebar {
        display: none;
      }
      .gallery-container {
        padding: 1rem 1rem 3rem 1rem;
      }
      .metadata-drawer {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 40;
        transform: translateX(100%);
        transition: transform 0.3s ease;
      }
      .metadata-drawer.open {
        transform: translateX(0);
      }
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       TOP EDITORIAL HEADER
       ======================================================================== -->
  <header>
    <div class="brand-section">
      <div class="brand-crest">
        <i data-lucide="shield-check" style="width: 19px; height: 19px;"></i>
      </div>
      <div class="brand-titles">
        <h1>atelier vault</h1>
        <p>2.0 tb private phone media hub</p>
      </div>
    </div>

    <!-- Live Search -->
    <div class="search-bar-wrap">
      <input type="text" id="searchInput" class="search-input" placeholder="search archives by tag, camera, or lens...">
      <i data-lucide="search" class="search-icon"></i>
    </div>

    <!-- Header Actions -->
    <div class="header-actions">
      <button class="btn-outline" onclick="openSyncModal()">
        <i data-lucide="cable" style="width: 14px; height: 14px;"></i>
        <span>sync phone</span>
      </button>

      <label for="directFileInput" class="btn-luxury">
        <i data-lucide="arrow-up-right" style="width: 14px; height: 14px;"></i>
        <span>upload files</span>
      </label>
      <input type="file" id="directFileInput" multiple accept="image/*,video/*" style="display: none;">
    </div>
  </header>

  <div class="app-body">
    <!-- ======================================================================
         LEFT SIDEBAR: 2.0 TB CAPACITY METRICS & ARCHIVE TAXONOMY
         ====================================================================== -->
    <aside class="sidebar">
      
      <!-- 2.0 TB (2,048 GB) METRIC DISPLAY -->
      <div class="storage-card">
        <div class="storage-header">
          <span class="storage-tag">vault capacity</span>
          <span class="storage-quota-badge">2,048 gb nvme</span>
        </div>

        <div class="storage-large-num">
          <span class="amount" id="usedGbLabel">684.2</span>
          <span class="total">/ 2,048 gb (2.0 tb)</span>
        </div>

        <!-- Multi-segment visual bar -->
        <div class="capacity-track">
          <div id="barRaw" class="segment-bar seg-raw" style="width: 18%;" title="ProRAW & High-Res"></div>
          <div id="barVideo" class="segment-bar seg-video" style="width: 12%;" title="Cinematic 4K/ProRes"></div>
          <div id="barBackup" class="segment-bar seg-backup" style="width: 3.4%;" title="Phone System Snapshots"></div>
        </div>

        <div class="capacity-legend">
          <span id="pctUsedLabel">33.4% allocated</span>
          <span id="availGbLabel">1,363.8 gb available</span>
        </div>

        <!-- Category details breakdown -->
        <div class="category-breakdown">
          <div class="category-row">
            <span class="category-name">
              <span class="cat-dot" style="background: var(--tan);"></span>
              <span>proraw / captures</span>
            </span>
            <span class="category-val" id="catRawLabel">368.4 gb</span>
          </div>
          <div class="category-row">
            <span class="category-name">
              <span class="cat-dot" style="background: var(--crimson-accent);"></span>
              <span>cinematic 4k / prores</span>
            </span>
            <span class="category-val" id="catVideoLabel">246.0 gb</span>
          </div>
          <div class="category-row">
            <span class="category-name">
              <span class="cat-dot" style="background: var(--light-brown);"></span>
              <span>phone backups & logs</span>
            </span>
            <span class="category-val" id="catBackupLabel">69.8 gb</span>
          </div>
        </div>
      </div>

      <!-- TETHERED DEVICE STATUS -->
      <div class="phone-sync-card">
        <div class="phone-sync-top">
          <div class="phone-meta">
            <div class="phone-icon-box">
              <i data-lucide="smartphone" style="width: 16px; height: 16px;"></i>
            </div>
            <div class="phone-texts">
              <h4>iphone 16 pro max</h4>
              <p>usb-c 3.2 gen 2 • tethered</p>
            </div>
          </div>
          <span class="status-pulse">
            <span class="status-dot"></span>
            <span>synced</span>
          </span>
        </div>
        <button class="btn-outline" style="justify-content: center; width: 100%;" onclick="openSyncModal()">
          <i data-lucide="refresh-cw" style="width: 13px; height: 13px;"></i>
          <span>run phone differential sync</span>
        </button>
      </div>

      <!-- ALBUM TAXONOMY NAVIGATION -->
      <div>
        <div class="nav-group-title">
          <span>curated albums</span>
          <i data-lucide="bookmark" style="width: 12px; height: 12px;"></i>
        </div>
        <ul class="album-nav" id="albumList">
          <li>
            <button class="album-btn active" data-album="all">
              <span>all archives</span>
              <span class="album-badge" id="countAll">0</span>
            </button>
          </li>
          <li>
            <button class="album-btn" data-album="camera-roll">
              <span>camera roll</span>
              <span class="album-badge" id="countRoll">0</span>
            </button>
          </li>
          <li>
            <button class="album-btn" data-album="cinematic-video">
              <span>cinematic video</span>
              <span class="album-badge" id="countVideo">0</span>
            </button>
          </li>
          <li>
            <button class="album-btn" data-album="favorites">
              <span>favorites</span>
              <span class="album-badge" id="countFav">0</span>
            </button>
          </li>
          <li>
            <button class="album-btn" data-album="phone-archives">
              <span>phone backups</span>
              <span class="album-badge" id="countBackups">0</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- CACHE & INDEXEDDB MANAGEMENT -->
      <div style="margin-top: auto; border-top: 1px solid var(--tan-subtle); padding-top: 1rem;">
        <div style="font-size: 0.72rem; color: var(--tan); font-style: italic; display: flex; justify-content: space-between; margin-bottom: 0.6rem;">
          <span>local database</span>
          <span id="indexedStatus">active (indexeddb)</span>
        </div>
        <button class="btn-outline" style="font-size: 0.72rem; width: 100%; justify-content: center;" onclick="resetVaultDemo()">
          <i data-lucide="rotate-ccw" style="width: 12px; height: 12px;"></i>
          <span>reload default archives</span>
        </button>
      </div>

    </aside>

    <!-- ======================================================================
         MAIN GALLERY & ARCHIVE FEED
         ====================================================================== -->
    <main class="main-gallery">
      
      <!-- LUXURY HERO DROPZONE -->
      <div class="drop-banner">
        <div class="dropzone-box" id="dropArea">
          <div class="dropzone-icon">
            <i data-lucide="upload" style="width: 18px; height: 18px;"></i>
          </div>
          <div class="dropzone-title">drop photos & 4k captures from your phone</div>
          <div class="dropzone-sub">files are preserved locally inside your browser via indexeddb binary storage</div>
        </div>
      </div>

      <!-- TOOLBAR & FILTERS -->
      <div class="gallery-toolbar">
        <div class="filter-pills">
          <button class="pill-btn active" data-filter="all">all media</button>
          <button class="pill-btn" data-filter="raw">proraw photos</button>
          <button class="pill-btn" data-filter="video">4k video</button>
          <button class="pill-btn" data-filter="portrait">portraits</button>
          <button class="pill-btn" data-filter="favorites">starred</button>
        </div>

        <div class="toolbar-tools">
          <span class="selection-banner" id="itemsCountText">showing 8 captures</span>

          <div class="view-mode-toggle">
            <button class="view-mode-btn active" id="btnViewGrid" title="editorial grid">
              <i data-lucide="grid" style="width: 14px; height: 14px;"></i>
            </button>
            <button class="view-mode-btn" id="btnViewList" title="archive list">
              <i data-lucide="list" style="width: 14px; height: 14px;"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- GALLERY CONTAINER -->
      <div class="gallery-container">
        <div id="mediaFeed" class="editorial-grid">
          <!-- Populated by JS -->
        </div>
      </div>

    </main>
  </div>

  <!-- ========================================================================
       FULLSCREEN LIGHTBOX & BESPOKE METADATA DRAWER
       ======================================================================== -->
  <div class="lightbox-modal" id="lightboxModal">
    <div class="lightbox-topbar">
      <div class="lightbox-titles">
        <h3 id="modalTitle">archive_item.dng</h3>
        <p id="modalSubInfo">apple proraw • 48 mp • 42.6 mb</p>
      </div>

      <div class="lightbox-actions">
        <button class="btn-outline" id="btnToggleFav">
          <i data-lucide="heart" style="width: 14px; height: 14px;"></i>
          <span>favorite</span>
        </button>
        <button class="btn-outline" onclick="downloadCurrentMedia()">
          <i data-lucide="download" style="width: 14px; height: 14px;"></i>
          <span>save file</span>
        </button>
        <button class="btn-outline" onclick="closeLightbox()">
          <i data-lucide="x" style="width: 14px; height: 14px;"></i>
          <span>close</span>
        </button>
      </div>
    </div>

    <div class="lightbox-stage">
      <button class="stage-nav-btn nav-prev" onclick="cycleModal(-1)">
        <i data-lucide="chevron-left" style="width: 20px; height: 20px;"></i>
      </button>

      <div class="stage-media-wrap" id="stageMediaContainer">
        <!-- Injected img or video -->
      </div>

      <button class="stage-nav-btn nav-next" onclick="cycleModal(1)">
        <i data-lucide="chevron-right" style="width: 20px; height: 20px;"></i>
      </button>

      <!-- METADATA EXIF DRAWER -->
      <div class="metadata-drawer" id="metadataDrawer">
        <div>
          <span class="drawer-section-title">camera hardware</span>
          <div class="exif-grid">
            <div class="exif-box">
              <span class="exif-label">camera model</span>
              <span class="exif-value" id="exifCamera">iphone 16 pro max</span>
            </div>
            <div class="exif-box">
              <span class="exif-label">lens focal</span>
              <span class="exif-value" id="exifLens">24mm (main)</span>
            </div>
          </div>
        </div>

        <div>
          <span class="drawer-section-title">exposure parameters</span>
          <div class="exif-grid">
            <div class="exif-box">
              <span class="exif-label">aperture</span>
              <span class="exif-value" id="exifAperture">ƒ/1.78</span>
            </div>
            <div class="exif-box">
              <span class="exif-label">shutter speed</span>
              <span class="exif-value" id="exifShutter">1/3200s</span>
            </div>
            <div class="exif-box">
              <span class="exif-label">iso sensitivity</span>
              <span class="exif-value" id="exifIso">iso 50</span>
            </div>
            <div class="exif-box">
              <span class="exif-label">resolution</span>
              <span class="exif-value" id="exifResolution">8064 × 6048</span>
            </div>
          </div>
        </div>

        <div>
          <span class="drawer-section-title">storage & archival</span>
          <div class="exif-grid">
            <div class="exif-box">
              <span class="exif-label">file size</span>
              <span class="exif-value" id="exifSize">38.4 mb</span>
            </div>
            <div class="exif-box">
              <span class="exif-label">archive bucket</span>
              <span class="exif-value" id="exifAlbum">camera roll</span>
            </div>
            <div class="exif-box" style="grid-column: span 2;">
              <span class="exif-label">geotag location</span>
              <span class="exif-value" id="exifLocation">paris, place vendôme</span>
            </div>
            <div class="exif-box" style="grid-column: span 2;">
              <span class="exif-label">timestamp</span>
              <span class="exif-value" id="exifDate">october 20, 2026 • 15:42</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ========================================================================
       TETHERED USB-C / CABLE PHONE SYNC SIMULATOR MODAL
       ======================================================================== -->
  <div class="sync-modal" id="syncModal">
    <div class="sync-dialog">
      <div class="sync-crest">
        <i data-lucide="cable" style="width: 24px; height: 24px;"></i>
      </div>
      <h3>tethered phone sync</h3>
      <p>synchronizing dcim camera roll & 4k video logs via usb-c 3.2</p>

      <div class="sync-progress-track">
        <div class="sync-progress-fill" id="syncProgressFill"></div>
      </div>

      <div class="sync-stats-row">
        <span id="syncRate">1.25 gb/s throughput</span>
        <span id="syncPercent">0%</span>
      </div>

      <div style="margin-top: 1.5rem; display: flex; justify-content: center; gap: 0.8rem;">
        <button class="btn-luxury" id="btnStartSync" onclick="startSyncSimulation()">start backup</button>
        <button class="btn-outline" onclick="closeSyncModal()">cancel</button>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       FLOATING BATCH ACTIONS BAR
       ======================================================================== -->
  <div class="batch-bar" id="batchBar">
    <span style="font-size: 0.8rem; font-style: italic; color: var(--tan);" id="batchCountLabel">0 items selected</span>
    <button class="btn-outline" onclick="batchToggleFavorite()">
      <i data-lucide="heart" style="width: 13px; height: 13px;"></i>
      <span>favorite</span>
    </button>
    <button class="btn-outline" onclick="batchDownload()">
      <i data-lucide="download" style="width: 13px; height: 13px;"></i>
      <span>download</span>
    </button>
    <button class="btn-luxury" style="padding: 0.4rem 0.8rem;" onclick="batchDelete()">
      <i data-lucide="trash" style="width: 13px; height: 13px;"></i>
      <span>delete</span>
    </button>
  </div>

  <!-- TOAST TRAY -->
  <div class="toast-tray" id="toastTray"></div>

  <!-- ========================================================================
       APPLICATION LOGIC, INDEXEDDB & MEDIA STATE
       ======================================================================== -->
  <script>
    /* Total Capacity: 2.0 TB (2,048 GB) */
    const TOTAL_CAPACITY_GB = 2048.0;
    const DB_NAME = 'AtelierVault_2TB_DB';
    const STORE_NAME = 'media_records';
    let db = null;

    let mediaVault = [];
    let activeFilter = 'all';
    let activeAlbum = 'all';
    let searchQuery = '';
    let currentViewMode = 'grid'; // 'grid' | 'list'
    let selectedIds = new Set();
    let currentLightboxIdx = 0;
    let filteredList = [];

    /* Pre-seeded Curated Luxury Media */
    const SEED_DATA = [
      {
        id: 'vault_seed_01',
