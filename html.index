        shutter: '1/120s',
        iso: 'ISO 100',
        resolution: '3840 × 2160 (4K 60fps)',
        location: 'Amalfi Coast, Italy',
        date: 'Oct 19, 2026',
        favorite: false
      },
      {
        id: 'vault_seed_03',
        title: 'IMG_8432_Leica_AtelierPortrait.dng',
        type: 'photo',
        category: 'portrait',
        album: 'camera-roll',
        url: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1600&q=85',
        thumb: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80',
        sizeMB: 54.6,
        camera: 'Leica M11-P',
