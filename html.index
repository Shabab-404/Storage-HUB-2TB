        resolution: '9528 × 6328 (60 MP)',
        location: 'Milan Fashion Atelier',
        date: 'Oct 18, 2026',
        favorite: true
      },
      {
        id: 'vault_seed_04',
        title: 'IMG_7781_KyotoGardens.heic',
        type: 'photo',
        category: 'raw',
        album: 'camera-roll',
        url: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=1600&q=85',
        thumb: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=600&q=80',
        sizeMB: 22.4,
        camera: 'iPhone 16 Pro Max',
        lens: '48mm ƒ/1.78 2x Tele',
        aperture: 'ƒ/1.78',
        shutter: '1/640s',
        iso: 'ISO 125',
        resolution: '5712 × 4284 (24 MP)',
        location: 'Kyoto, Arashiyama',
        date: 'Oct 15, 2026',
        favorite: false
      },
      {
        id: 'vault_seed_05',
        title: 'VID_0891_ProResLog_Monaco.mov',
        type: 'video',
        category: 'video',
